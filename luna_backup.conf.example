# Copy to /etc/luna-backup/luna_backup.conf and set mode 600.
LUNACM_BIN="/usr/safenet/lunaclient/bin/lunacm"
MODE="client_usb"
MIN_CLIENT_VERSION="10.3.0"
SOURCE_TYPE="partition"
SOURCE_PARTITION_LABEL="partition1"
SOURCE_SLOT=""
SOURCE_HA_GROUP_LABEL=""
SOURCE_HSM_HOST="10.0.0.10"
BACKUP_HSM_SLOT="5"
BACKUP_ARCHIVE_NAME="bank-prod-partition1"
BACKUP_DOMAIN_REFERENCE="domain-label-ref-only-no-secret"
RETENTION_COUNT="7"
COMMAND_TIMEOUT_SECONDS="300"
LOG_DIR="/var/log/luna-backup"
STATE_DIR="/var/lib/luna-backup"
LOCK_FILE="/var/lock/luna-backup.lock"
EMAIL_ENABLED="false"
EMAIL_TO=""
SCHEDULE_TYPE="cron"
CRON_EXPRESSION="0 2 * * *"
REQUIRE_PED="true"
DRY_RUN_DEFAULT="false"
BACKUP_WINDOW="01:00-03:00 UTC"
REPORT_HOOK=""
SYSTEMD_TIMER_NAME="luna-backup.timer"
SERVICE_USER="luna-backup"
